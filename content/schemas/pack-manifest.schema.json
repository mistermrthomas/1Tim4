{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/formation/pack-manifest.schema.json",
  "title": "ContentPackManifest",
  "type": "object",
  "required": [
    "packId",
    "version",
    "schemaVersion",
    "kind",
    "locale",
    "publicationStatus",
    "translationDependencies",
    "contentOwner",
    "reviewStatus",
    "checksumSha256",
    "minAppVersion",
    "releaseNotes",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "packId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "schemaVersion": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": [
        "foundation",
        "formation",
        "season",
        "scripture",
        "workouts",
        "prompts",
        "coaching",
        "nutrition",
        "safety",
        "expansion"
      ]
    },
    "locale": { "type": "string" },
    "publicationStatus": {
      "type": "string",
      "enum": ["draft", "review", "published", "yanked"]
    },
    "translationDependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contentOwner": { "type": "string" },
    "reviewStatus": {
      "type": "string",
      "enum": ["unreviewed", "theologically_reviewed", "legal_reviewed"]
    },
    "checksumSha256": { "type": "string", "minLength": 64, "maxLength": 64 },
    "minAppVersion": { "type": "string" },
    "releaseNotes": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "type"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" }
        }
      }
    }
  }
}
