{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/formation/season-pack.schema.json",
  "title": "SeasonPackBundle",
  "type": "object",
  "required": ["season", "weeks", "days", "morningVariants", "teachings", "scriptureReferences", "scriptureTexts", "assignments", "prompts", "coachIntents", "workouts", "recoveryDays"],
  "additionalProperties": false,
  "properties": {
    "season": {
      "type": "object",
      "required": ["id", "title", "theme", "primaryFocusKey", "secondaryFocusKey", "physicalTemplateId", "weekCount", "reassessmentWeekIndex", "graceDays", "summary"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "theme": { "type": "string" },
        "primaryFocusKey": { "type": "string" },
        "secondaryFocusKey": { "type": "string" },
        "physicalTemplateId": { "type": "string" },
        "weekCount": { "type": "integer", "minimum": 1 },
        "reassessmentWeekIndex": { "type": "integer", "minimum": 1 },
        "graceDays": { "type": "integer", "minimum": 0 },
        "summary": { "type": "string" }
      },
      "additionalProperties": false
    },
    "weeks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["weekIndex", "stageKey", "theme", "intent"],
        "properties": {
          "weekIndex": { "type": "integer" },
          "stageKey": { "type": "string" },
          "theme": { "type": "string" },
          "intent": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["dayKey", "weekIndex", "dayInWeek", "morningVariantIds", "assignmentId", "eveningPromptIds", "sessionType", "coachIntentKeys"],
        "properties": {
          "dayKey": { "type": "string" },
          "weekIndex": { "type": "integer" },
          "dayInWeek": { "type": "integer", "minimum": 1, "maximum": 7 },
          "morningVariantIds": {
            "type": "object",
            "required": ["full", "short", "two_minute"],
            "properties": {
              "full": { "type": "string" },
              "short": { "type": "string" },
              "two_minute": { "type": "string" }
            },
            "additionalProperties": false
          },
          "assignmentId": { "type": "string" },
          "eveningPromptIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "middayPromptId": { "type": "string" },
          "sessionType": { "type": "string", "enum": ["workout", "recovery", "rest_walk"] },
          "workoutSessionId": { "type": ["string", "null"] },
          "recoveryDayId": { "type": ["string", "null"] },
          "coachIntentKeys": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "optionalJournalPromptId": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "morningVariants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "mode", "teachingId", "primaryReferenceId", "intentionPromptId", "bodyAction", "prayerPromptId"],
        "properties": {
          "id": { "type": "string" },
          "mode": { "type": "string", "enum": ["full", "short", "two_minute"] },
          "teachingId": { "type": "string" },
          "primaryReferenceId": { "type": "string" },
          "supportingReferenceIds": { "type": "array", "items": { "type": "string" } },
          "explanation": { "type": "string" },
          "intentionPromptId": { "type": "string" },
          "bodyAction": {
            "type": "object",
            "required": ["kind", "summary"],
            "properties": {
              "kind": { "type": "string", "enum": ["workout_ref", "mobility", "walk", "breath_stand"] },
              "summary": { "type": "string" },
              "workoutSessionId": { "type": "string" },
              "recoveryDayId": { "type": "string" }
            }
          },
          "prayerPromptId": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "teachings": { "type": "array" },
    "scriptureReferences": { "type": "array" },
    "scriptureTexts": { "type": "array" },
    "assignments": { "type": "array" },
    "prompts": { "type": "array" },
    "coachIntents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["intentKey", "groundingReferenceIds", "jesusTeachingId", "template", "priorityLens"],
        "properties": {
          "intentKey": { "type": "string" },
          "groundingReferenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "jesusTeachingId": { "type": "string" },
          "supportingReferenceIds": { "type": "array", "items": { "type": "string" } },
          "template": { "type": "string" },
          "priorityLens": { "type": "string", "const": "jesus_primary" },
          "situation": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "workouts": {
      "type": "object",
      "required": ["templates", "exercises"],
      "properties": {
        "templates": { "type": "array" },
        "exercises": { "type": "array" }
      }
    },
    "recoveryDays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "mobilityNotes", "walkMinutes", "recoveryPromptId"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "mobilityNotes": { "type": "string" },
          "walkMinutes": { "type": "integer" },
          "recoveryPromptId": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
