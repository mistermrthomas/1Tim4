# Copy to .env.local for local dev. Add the same keys in Vercel → Settings → Environment Variables.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# Server-side only — never use a VITE_ prefix for the OpenAI key.
# Local: copy to .env.local and run `npx vercel dev` so /api routes load env.
# Vercel: Project → Settings → Environment Variables → add OPENAI_API_KEY → Redeploy.
OPENAI_API_KEY=
# Optional allowlisted model override (gpt-4o-mini | gpt-4o | gpt-4.1-mini | gpt-4.1)
# OPENAI_MODEL=gpt-4o-mini
# VITE_ASSESSMENT_AI=false
# VITE_GO_DEEPER_AI=false
# VITE_READING_QUESTIONS_AI=false
